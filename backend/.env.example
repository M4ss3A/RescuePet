# Copiar este archivo como .env y completar los valores reales

# Conexión a PostgreSQL: postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgresql+psycopg://postgres:TU_CONTRASEÑA@localhost:5432/rescuepet

# Orígenes permitidos para CORS (frontend con Vite), separados por coma
CORS_ORIGINS=http://localhost:5173



# Clave para firmar los JWT: mínimo 32 caracteres. Generarla con:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=COMPLETAR_CON_UNA_CLAVE_DE_AL_MENOS_32_CARACTERES

# Administrador inicial (opcional): si se completan, se crea al iniciar la app
ADMIN_EMAIL=admin@rescuepet.com
ADMIN_PASSWORD=COMPLETAR