# Copiar este archivo como .env y completar los valores reales

# Conexión a PostgreSQL: postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgresql+psycopg://postgres:TU_CONTRASEÑA@localhost:5432/rescuepet

# Orígenes permitidos para CORS (frontend con Vite), separados por coma
CORS_ORIGINS=http://localhost:5173